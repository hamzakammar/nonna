# Copy to .env.local. Everything is optional: the app runs with zero keys (template voice, mock channels).

# Claude: intent parsing + Nonna's phrasing (Lane 2) and weekly Gentle Truth wording (Lane 3)
ANTHROPIC_API_KEY=
NONNA_FAST_MODEL=claude-haiku-4-5-20251001   # live voice: latency matters
NONNA_SMART_MODEL=claude-sonnet-5            # end-of-day reports
NONNA_VISION_MODEL=claude-opus-5             # Price Watch: reading competitor menu photos (Lane 1)

# Facebook Messenger (Lane 2, P1)
MESSENGER_PAGE_TOKEN=
MESSENGER_RECIPIENT_PSID=

# Optional nicer TTS (Lane 2, P2)
TTS_API_KEY=

# Where the SQLite file lives (default ./data/nonna.db)
# NONNA_DB_PATH=

# Nonna's allowance (Lane 1): routine restocks under the cap are placed without asking
# AUTOPILOT_MAX_ORDER_CENTS=2500
# AUTOPILOT_WEEKLY_BUDGET_CENTS=10000

# Price Watch (Lane 1): never suggest a price below this margin
# PRICEWATCH_MIN_MARGIN=0.6

# Price Watch automatic discovery (Lane 1)
# PRICEWATCH_DISCOVERY=mock          # mock (offline demo) | osm (free OpenStreetMap) | google (free tier, capped)
# PRICEWATCH_AUTO=1                  # 0 = no daily refresh
# SHOP_NAME="Nonna's Bakery"         # excluded from results
# SHOP_LAT=43.4643
# SHOP_LNG=-80.5204
# PRICEWATCH_RADIUS_M=2000
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_MONTHLY_CAP=900      # refuse calls past this, so we stay inside Google's free quota
# OVERPASS_URL=                      # pin one Overpass server (default: public servers with fallback)
